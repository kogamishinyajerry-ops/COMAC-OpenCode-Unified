# COMAC AgentOS — Force CRLF on Windows-only scripts
# Without this, git on macOS/Linux/Windows-with-autocrlf=false rewrites
# .bat files to LF, breaking CMD.exe parsing on the deployment target.
# See v2.3.1 commit 8f03285 for context.

# Scripts that CMD.exe / call must parse — MUST be CRLF
*.bat          text eol=crlf
*.cmd          text eol=crlf
messages/*.txt text eol=crlf

# .py and .md stay as-is (LF is fine for both Python and Markdown)
*.py           text eol=lf
*.md           text eol=lf
*.json         text eol=lf
